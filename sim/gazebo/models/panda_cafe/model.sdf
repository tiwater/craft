    <link name="panda_link7">
      <pose relative_to="panda_link6">0.088 0 0 1.570796 0 0</pose>
      <inertial><mass>0.6</mass><inertia><ixx>0.008</ixx><iyy>0.008</iyy><izz>0.008</izz></inertia></inertial>
