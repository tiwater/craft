      <axis><xyz>0 0 1</xyz><limit><lower>-2.8973</lower><upper>2.8973</upper><effort>12</effort></limit><dynamics><damping>2.0</damping></dynamics></axis>
    </joint>

    <link name="panda_hand">
      <pose relative_to="panda_link7">0 0 0.107 0 0 -0.785398</pose>
      <inertial><mass>0.7</mass><inertia><ixx>0.006</ixx><iyy>0.006</iyy><izz>0.006</izz></inertia></inertial>
      <visual name="hand_vis"><geometry><mesh><uri>model://panda_cafe/meshes/hand_vis.stl</uri></mesh></geometry><material><ambient>0.95 0.96 0.97 1</ambient><diffuse>0.95 0.96 0.97 1</diffuse><pbr><metal><metalness>0.12</metalness><roughness>0.32</roughness></metal></pbr></material></visual>
      <sensor name="camera_wrist" type="camera">
        <pose>0.06 0 0.02 0 1.35 0</pose>
        <always_on>true</always_on>
        <update_rate>15</update_rate>
        <topic>/craft/camera/wrist/image_raw</topic>
        <camera>
          <horizontal_fov>1.15</horizontal_fov>
          <image><width>800</width><height>450</height><format>R8G8B8</format></image>
          <clip><near>0.04</near><far>10.0</far></clip>
          <noise><type>gaussian</type><mean>0.0</mean><stddev>0.007</stddev></noise>
        </camera>
      </sensor>
    </link>
    <joint name="panda_hand_joint" type="fixed">
      <parent>panda_link7</parent><child>panda_hand</child>
    </joint>

    <link name="panda_leftfinger">
      <pose relative_to="panda_hand">0 0 0.0584 0 0 0</pose>
      <inertial><mass>0.08</mass><inertia><ixx>0.001</ixx><iyy>0.001</iyy><izz>0.001</izz></inertia></inertial>
      <visual name="finger1_vis"><geometry><mesh><uri>model://panda_cafe/meshes/finger_vis.stl</uri></mesh></geometry><material><ambient>0.20 0.22 0.25 1</ambient><diffuse>0.20 0.22 0.25 1</diffuse><pbr><metal><metalness>0.35</metalness><roughness>0.42</roughness></metal></pbr></material></visual>
      <collision name="finger1_col"><geometry><mesh><uri>model://panda_cafe/meshes/finger.stl</uri></mesh></geometry><surface><friction><ode><mu>1.4</mu><mu2>1.2</mu2></ode></friction></surface></collision>
    </link>
    <joint name="panda_finger_joint1" type="prismatic">
      <parent>panda_hand</parent><child>panda_leftfinger</child>
      <axis><xyz>0 1 0</xyz><limit><lower>0.0</lower><upper>0.04</upper><effort>20</effort></limit><dynamics><damping>5.0</damping></dynamics></axis>
    </joint>

    <link name="panda_rightfinger">
      <pose relative_to="panda_hand">0 0 0.0584 0 0 3.141593</pose>
      <inertial><mass>0.08</mass><inertia><ixx>0.001</ixx><iyy>0.001</iyy><izz>0.001</izz></inertia></inertial>
      <visual name="finger2_vis"><geometry><mesh><uri>model://panda_cafe/meshes/finger_vis.stl</uri></mesh></geometry><material><ambient>0.20 0.22 0.25 1</ambient><diffuse>0.20 0.22 0.25 1</diffuse><pbr><metal><metalness>0.35</metalness><roughness>0.42</roughness></metal></pbr></material></visual>
      <collision name="finger2_col"><geometry><mesh><uri>model://panda_cafe/meshes/finger.stl</uri></mesh></geometry><surface><friction><ode><mu>1.4</mu><mu2>1.2</mu2></ode></friction></surface></collision>
