    </joint>

    <link name="panda_link4">
      <pose relative_to="panda_link3">0.0825 0 0 1.570796 0 0</pose>
      <inertial><mass>2.0</mass><inertia><ixx>0.02</ixx><iyy>0.02</iyy><izz>0.02</izz></inertia></inertial>
      <visual name="link4_vis"><geometry><mesh><uri>model://panda_cafe/meshes/link4.stl</uri></mesh></geometry><material><ambient>0.95 0.96 0.97 1</ambient><diffuse>0.95 0.96 0.97 1</diffuse><pbr><metal><metalness>0.12</metalness><roughness>0.32</roughness></metal></pbr></material></visual>
    </link>
    <joint name="panda_joint4" type="revolute">
      <parent>panda_link3</parent><child>panda_link4</child>
      <axis><xyz>0 0 1</xyz><limit><lower>-3.0718</lower><upper>-0.0698</upper><effort>87</effort></limit><dynamics><damping>6.0</damping></dynamics></axis>
    </joint>

    <link name="panda_link5">
      <pose relative_to="panda_link4">-0.0825 0.384 0 -1.570796 0 0</pose>
      <inertial><mass>2.0</mass><inertia><ixx>0.02</ixx><iyy>0.02</iyy><izz>0.02</izz></inertia></inertial>
      <visual name="link5_vis"><geometry><mesh><uri>model://panda_cafe/meshes/link5.stl</uri></mesh></geometry><material><ambient>0.95 0.96 0.97 1</ambient><diffuse>0.95 0.96 0.97 1</diffuse><pbr><metal><metalness>0.12</metalness><roughness>0.32</roughness></metal></pbr></material></visual>
    </link>
    <joint name="panda_joint5" type="revolute">
      <parent>panda_link4</parent><child>panda_link5</child>
      <axis><xyz>0 0 1</xyz><limit><lower>-2.8973</lower><upper>2.8973</upper><effort>12</effort></limit><dynamics><damping>4.0</damping></dynamics></axis>
    </joint>

    <link name="panda_link6">
      <pose relative_to="panda_link5">0 0 0 1.570796 0 0</pose>
      <inertial><mass>1.5</mass><inertia><ixx>0.015</ixx><iyy>0.015</iyy><izz>0.015</izz></inertia></inertial>
      <visual name="link6_vis"><geometry><mesh><uri>model://panda_cafe/meshes/link6.stl</uri></mesh></geometry><material><ambient>0.95 0.96 0.97 1</ambient><diffuse>0.95 0.96 0.97 1</diffuse><pbr><metal><metalness>0.12</metalness><roughness>0.32</roughness></metal></pbr></material></visual>
