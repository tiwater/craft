<?xml version="1.0"?>
<sdf version="1.9">
  <model name="panda_cafe">
    <pose>-0.18 0.0 0.97 0 0 0</pose>
    <joint name="world_fixed" type="fixed">
      <parent>world</parent>
      <child>panda_link0</child>
    </joint>

    <link name="panda_link0">
      <inertial><mass>4.0</mass><inertia><ixx>0.04</ixx><iyy>0.04</iyy><izz>0.04</izz></inertia></inertial>
      <visual name="link0_vis">
        <geometry><mesh><uri>model://panda_cafe/meshes/link0.stl</uri></mesh></geometry>
        <material><ambient>0.95 0.96 0.97 1</ambient><diffuse>0.95 0.96 0.97 1</diffuse><pbr><metal><metalness>0.12</metalness><roughness>0.32</roughness></metal></pbr></material>
      </visual>
      <collision name="link0_col">
        <geometry><mesh><uri>model://panda_cafe/meshes/link0.stl</uri></mesh></geometry>
      </collision>
    </link>

    <link name="panda_link1">
      <pose relative_to="panda_link0">0 0 0.333 0 0 0</pose>
      <inertial><mass>3.0</mass><inertia><ixx>0.03</ixx><iyy>0.03</iyy><izz>0.03</izz></inertia></inertial>
      <visual name="link1_vis"><geometry><mesh><uri>model://panda_cafe/meshes/link1.stl</uri></mesh></geometry><material><ambient>0.95 0.96 0.97 1</ambient><diffuse>0.95 0.96 0.97 1</diffuse><pbr><metal><metalness>0.12</metalness><roughness>0.32</roughness></metal></pbr></material></visual>
    </link>
    <joint name="panda_joint1" type="revolute">
      <parent>panda_link0</parent><child>panda_link1</child>
      <axis><xyz>0 0 1</xyz><limit><lower>-2.8973</lower><upper>2.8973</upper><effort>87</effort></limit><dynamics><damping>8.0</damping></dynamics></axis>
    </joint>

    <link name="panda_link2">
      <pose relative_to="panda_link1">0 0 0 -1.570796 0 0</pose>
      <inertial><mass>3.0</mass><inertia><ixx>0.03</ixx><iyy>0.03</iyy><izz>0.03</izz></inertia></inertial>
      <visual name="link2_vis"><geometry><mesh><uri>model://panda_cafe/meshes/link2.stl</uri></mesh></geometry><material><ambient>0.95 0.96 0.97 1</ambient><diffuse>0.95 0.96 0.97 1</diffuse><pbr><metal><metalness>0.12</metalness><roughness>0.32</roughness></metal></pbr></material></visual>
    </link>
    <joint name="panda_joint2" type="revolute">
      <parent>panda_link1</parent><child>panda_link2</child>
      <axis><xyz>0 0 1</xyz><limit><lower>-1.7628</lower><upper>1.7628</upper><effort>87</effort></limit><dynamics><damping>8.0</damping></dynamics></axis>
    </joint>

    <link name="panda_link3">
      <pose relative_to="panda_link2">0 -0.316 0 1.570796 0 0</pose>
      <inertial><mass>2.0</mass><inertia><ixx>0.02</ixx><iyy>0.02</iyy><izz>0.02</izz></inertia></inertial>
      <visual name="link3_vis"><geometry><mesh><uri>model://panda_cafe/meshes/link3.stl</uri></mesh></geometry><material><ambient>0.95 0.96 0.97 1</ambient><diffuse>0.95 0.96 0.97 1</diffuse><pbr><metal><metalness>0.12</metalness><roughness>0.32</roughness></metal></pbr></material></visual>
