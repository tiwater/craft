<?xml version="1.0"?>
<sdf version="1.9">
  <model name="cafe_workstation">
    <static>true</static>
    <link name="workstation_link">
      <!-- Walnut Café Bar Counter -->
      <collision name="counter_col">
        <pose>0.40 0.0 0.50 0 0 0</pose>
        <geometry><box><size>0.88 0.96 1.00</size></box></geometry>
        <surface>
          <friction><ode><mu>0.90</mu><mu2>0.85</mu2></ode></friction>
        </surface>
      </collision>
      <visual name="counter_vis">
        <pose>0.40 0.0 0.50 0 0 0</pose>
        <geometry><box><size>0.88 0.96 1.00</size></box></geometry>
        <material><ambient>0.78 0.64 0.52 1</ambient><diffuse>0.78 0.64 0.52 1</diffuse><pbr><metal><albedo_map>model://cafe_workstation/textures/dark-wood.png</albedo_map><metalness>0.05</metalness><roughness>0.42</roughness></metal></pbr></material>
      </visual>
      <visual name="counter_trim_vis">
        <pose>-0.042 0.0 0.97 0 0 0</pose>
        <geometry><box><size>0.008 0.964 0.050</size></box></geometry>
        <material><ambient>0.80 0.83 0.86 1</ambient><diffuse>0.80 0.83 0.86 1</diffuse><pbr><metal><albedo_map>model://cafe_workstation/textures/steel-brushed.png</albedo_map><metalness>0.88</metalness><roughness>0.26</roughness></metal></pbr></material>
      </visual>
      <visual name="bar_mat_vis">
        <pose>0.30 0.0 1.001 0 0 0</pose>
        <geometry><box><size>0.30 0.48 0.002</size></box></geometry>
        <material><ambient>0.16 0.17 0.19 1</ambient><diffuse>0.16 0.17 0.19 1</diffuse><pbr><metal><albedo_map>model://cafe_workstation/textures/gray-felt.png</albedo_map><metalness>0.02</metalness><roughness>0.92</roughness></metal></pbr></material>
      </visual>

      <!-- Studio Brick Back & Side Walls -->
      <visual name="back_wall_vis">
        <pose>1.02 0.0 1.65 0 0 0</pose>
        <geometry><box><size>0.08 4.2 3.3</size></box></geometry>
        <material><ambient>0.90 0.88 0.85 1</ambient><diffuse>0.90 0.88 0.85 1</diffuse><pbr><metal><albedo_map>model://cafe_workstation/textures/white-bricks.png</albedo_map><metalness>0.02</metalness><roughness>0.85</roughness></metal></pbr></material>
      </visual>
      <visual name="side_wall_vis">
        <pose>0.15 1.15 1.65 0 0 0</pose>
        <geometry><box><size>2.8 0.08 3.3</size></box></geometry>
        <material><ambient>0.90 0.88 0.85 1</ambient><diffuse>0.90 0.88 0.85 1</diffuse><pbr><metal><albedo_map>model://cafe_workstation/textures/white-bricks.png</albedo_map><metalness>0.02</metalness><roughness>0.85</roughness></metal></pbr></material>
      </visual>

      <!-- Pickup Slot & Hazard No-Go Floor Decals -->
      <visual name="slot_pickup_1_vis">
        <pose>0.38 -0.17 1.0015 0 0 0</pose>
        <geometry><cylinder><radius>0.054</radius><length>0.002</length></cylinder></geometry>
        <material><ambient>0.12 0.72 0.95 0.8</ambient><diffuse>0.12 0.72 0.95 0.8</diffuse></material>
      </visual>
      <visual name="slot_pickup_2_vis">
        <pose>0.38 0.17 1.0015 0 0 0</pose>
        <geometry><cylinder><radius>0.054</radius><length>0.002</length></cylinder></geometry>
        <material><ambient>0.96 0.68 0.14 0.8</ambient><diffuse>0.96 0.68 0.14 0.8</diffuse></material>
      </visual>
      <visual name="zone_steam_nogo_vis">
        <pose>0.56 0.22 1.0015 0 0 0</pose>
        <geometry><box><size>0.15 0.15 0.002</size></box></geometry>
        <material><ambient>0.92 0.18 0.16 0.75</ambient><diffuse>0.92 0.18 0.16 0.75</diffuse></material>
      </visual>

      <!-- Commercial Dual-Group Espresso Machine -->
      <collision name="machine_base_col">
        <pose>0.625 0.0 1.155 0 0 0</pose>
        <geometry><box><size>0.22 0.29 0.31</size></box></geometry>
      </collision>
      <visual name="machine_base_vis">
        <pose>0.625 0.0 1.155 0 0 0</pose>
        <geometry><box><size>0.22 0.29 0.31</size></box></geometry>
        <material><ambient>0.82 0.84 0.88 1</ambient><diffuse>0.82 0.84 0.88 1</diffuse><pbr><metal><albedo_map>model://cafe_workstation/textures/steel-brushed.png</albedo_map><metalness>0.88</metalness><roughness>0.25</roughness></metal></pbr></material>
      </visual>
      <visual name="machine_top_vis">
        <pose>0.565 0.0 1.345 0 0 0</pose>
        <geometry><box><size>0.344 0.296 0.084</size></box></geometry>
        <material><ambient>0.20 0.22 0.25 1</ambient><diffuse>0.20 0.22 0.25 1</diffuse><pbr><metal><albedo_map>model://cafe_workstation/textures/steel-scratched.png</albedo_map><metalness>0.75</metalness><roughness>0.38</roughness></metal></pbr></material>
      </visual>
      <visual name="group_head_vis">
        <pose>0.45 0.0 1.285 0 0 0</pose>
        <geometry><cylinder><radius>0.036</radius><length>0.048</length></cylinder></geometry>
        <material><ambient>0.90 0.74 0.40 1</ambient><diffuse>0.90 0.74 0.40 1</diffuse><pbr><metal><albedo_map>model://cafe_workstation/textures/brass-ambra.png</albedo_map><metalness>0.90</metalness><roughness>0.22</roughness></metal></pbr></material>
      </visual>
      <visual name="portafilter_cup_vis">
        <pose>0.45 0.0 1.256 0 0 0</pose>
        <geometry><cylinder><radius>0.028</radius><length>0.032</length></cylinder></geometry>
        <material><ambient>0.84 0.86 0.88 1</ambient><diffuse>0.84 0.86 0.88 1</diffuse><pbr><metal><albedo_map>model://cafe_workstation/textures/steel-brushed.png</albedo_map><metalness>0.90</metalness><roughness>0.22</roughness></metal></pbr></material>
      </visual>
      <visual name="brew_spout_vis">
        <pose>0.45 0.0 1.232 0 0 0</pose>
        <geometry><cylinder><radius>0.011</radius><length>0.032</length></cylinder></geometry>
        <material><ambient>0.85 0.87 0.90 1</ambient><diffuse>0.85 0.87 0.90 1</diffuse><pbr><metal><albedo_map>model://cafe_workstation/textures/steel-brushed.png</albedo_map><metalness>0.92</metalness><roughness>0.20</roughness></metal></pbr></material>
      </visual>
      <visual name="pressure_gauge_vis">
        <pose>0.512 -0.075 1.245 0 1.5708 0</pose>
        <geometry><cylinder><radius>0.022</radius><length>0.012</length></cylinder></geometry>
        <material><ambient>0.92 0.76 0.42 1</ambient><diffuse>0.92 0.76 0.42 1</diffuse><pbr><metal><albedo_map>model://cafe_workstation/textures/brass-ambra.png</albedo_map><metalness>0.88</metalness><roughness>0.24</roughness></metal></pbr></material>
      </visual>
      <collision name="drip_tray_col">
        <pose>0.45 0.0 1.004 0 0 0</pose>
        <geometry><box><size>0.156 0.21 0.008</size></box></geometry>
      </collision>
      <visual name="drip_tray_vis">
        <pose>0.45 0.0 1.004 0 0 0</pose>
        <geometry><box><size>0.156 0.21 0.008</size></box></geometry>
        <material><ambient>0.22 0.24 0.27 1</ambient><diffuse>0.22 0.24 0.27 1</diffuse><pbr><metal><albedo_map>model://cafe_workstation/textures/steel-scratched.png</albedo_map><metalness>0.72</metalness><roughness>0.42</roughness></metal></pbr></material>
      </visual>
      <visual name="l2_safe_ring_vis">
        <pose>0.45 0.0 1.009 0 0 0</pose>
        <geometry><cylinder><radius>0.030</radius><length>0.0012</length></cylinder></geometry>
        <material><ambient>0.16 0.86 0.48 0.65</ambient><diffuse>0.16 0.86 0.48 0.65</diffuse></material>
      </visual>
      <visual name="steam_wand_vis">
        <pose>0.55 0.16 1.20 0.58 0.15 0</pose>
        <geometry><cylinder><radius>0.0065</radius><length>0.16</length></cylinder></geometry>
        <material><ambient>0.86 0.88 0.90 1</ambient><diffuse>0.86 0.88 0.90 1</diffuse><pbr><metal><albedo_map>model://cafe_workstation/textures/steel-brushed.png</albedo_map><metalness>0.92</metalness><roughness>0.18</roughness></metal></pbr></material>
      </visual>

      <!-- 3 Fixed OGRE2 RGB-D Sensors with Gaussian Imaging Noise -->
      <sensor name="camera_overview" type="camera">
        <pose>-0.42 -0.94 1.72 0 0.42 0.96</pose>
        <always_on>true</always_on>
        <update_rate>15</update_rate>
        <topic>/craft/camera/overview/image_raw</topic>
        <camera>
          <horizontal_fov>1.1500</horizontal_fov>
          <image>
            <width>800</width>
            <height>450</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.05</near>
            <far>15.0</far>
          </clip>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.007</stddev>
          </noise>
        </camera>
      </sensor>
      <sensor name="camera_overhead" type="camera">
        <pose>0.33 0.00 2.02 0 1.5708 0</pose>
        <always_on>true</always_on>
        <update_rate>15</update_rate>
        <topic>/craft/camera/overhead/image_raw</topic>
        <camera>
          <horizontal_fov>1.1800</horizontal_fov>
          <image>
            <width>800</width>
            <height>450</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.05</near>
            <far>15.0</far>
          </clip>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.007</stddev>
          </noise>
        </camera>
      </sensor>
      <sensor name="camera_spout" type="camera">
        <pose>0.12 -0.38 1.24 0 0.22 0.82</pose>
        <always_on>true</always_on>
        <update_rate>15</update_rate>
        <topic>/craft/camera/spout/image_raw</topic>
        <camera>
          <horizontal_fov>0.9600</horizontal_fov>
          <image>
            <width>800</width>
            <height>450</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.05</near>
            <far>15.0</far>
          </clip>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.007</stddev>
          </noise>
        </camera>
      </sensor>
    </link>
  </model>
</sdf>
