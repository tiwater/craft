    "instruction": "\u5236\u4f5c\u4e00\u676f\u5802\u98df\u70ed\u7f8e\u5f0f\uff0c\u9001\u52301\u53f7\u53d6\u9910\u53e3\uff1b\u82e5\u653e\u676f\u504f\u79fb\u5148\u5fae\u8c03\u5c45\u4e2d\uff0c\u82e5\u51b2\u716e\u56de\u6267\u672a\u77e5\u5148\u67e5\u8be2\u72b6\u6001\u5207\u52ff\u91cd\u590d\u542f\u52a8\u3002",
